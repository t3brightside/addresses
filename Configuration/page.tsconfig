TCEFORM.tt_content.tx_addresses_template.addItems {
  0 = Default
  cards = Cards
  list = List
  table = Table
}

TCEFORM.tt_content.tx_addresses_titlewrap.addItems {
  0 = Default
  h2 = H2
  h3 = H3
  h4 = H4
  p = p
}

TCEFORM.tt_content.tx_addresses_cropratio.addItems {
  0 = Default
  tv = TV (4:3)
  widescreen = Widescreen (16:9)
  anamorphic = Anamorphic (2.39:1)
  square = Square (1:1)
  portrait = Portrait (3:4)
  tower = Tower (9:16)
  skyscraper = Skyscraper (1:2.39)
  none = None
}

# For TYPO3 v12

mod.wizards.newContentElement.wizardItems.common {
  elements {
    addresses_frompages {
      iconIdentifier = mimetypes-x-content-addresses
      title = Addresses: from pages
      description = Shows addresss from selected pages or sys folders.
      tt_content_defValues {
        CType = addresses_frompages
      }
    }
    addresses_selected {
      iconIdentifier = mimetypes-x-content-addresses
      title = Addresses: selected
      description = Shows selected address records.
      tt_content_defValues {
        CType = addresses_selected
      }
    }
  }
  show := addToList(addresses_frompages,addresses_selected)
}